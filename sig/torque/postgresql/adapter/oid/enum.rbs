module Torque
  module PostgreSQL
    module Adapter
      module OID
        class Enum < ActiveRecord::ConnectionAdapters::PostgreSQL::OID::Enum
          type row = Hash[String, untyped]

          attr_reader name: String
          attr_reader klass: singleton(Attributes::Enum) | singleton(Attributes::EnumSet)
          attr_reader set_klass: EnumSet?
          attr_reader enum_klass: Enum | singleton(Attributes::Enum)

          def self.create: (row row, ActiveRecord::Type::HashLookupTypeMap type_map) -> untyped
          def initialize: (String name) -> void
          def hash: () -> Integer
          def serialize: (untyped value) -> String?
          def assert_valid_value: (untyped value) -> untyped
          def type_cast_for_schema: (untyped value) -> String
          def ==: (untyped other) -> bool

          private

          def cast_value: (untyped value) -> untyped
        end
      end
    end
  end
end
