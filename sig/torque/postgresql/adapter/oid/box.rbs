module Torque
  module PostgreSQL
    class Box < ::Struct[untyped]
      def x1: () -> Numeric
      def x1=: (Numeric value) -> Numeric
      def y1: () -> Numeric
      def y1=: (Numeric value) -> Numeric
      def x2: () -> Numeric
      def x2=: (Numeric value) -> Numeric
      def y2: () -> Numeric
      def y2=: (Numeric value) -> Numeric

      def points: () -> Array[untyped]
    end

    module Adapter
      module OID
        class Box < Torque::PostgreSQL::GeometryBuilder
          PIECES: ::Array[Symbol]
          FORMATION: String
        end
      end
    end
  end
end

class ActiveRecord::Box < Torque::PostgreSQL::Box
end
