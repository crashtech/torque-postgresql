module Torque
  module PostgreSQL
    module Adapter
      module OID
        class EnumSet < Enum
          def initialize: (String name, singleton(Attributes::Enum) enum_klass) -> void
          def type: () -> :enum
          def deserialize: (untyped value) -> untyped
          def serialize: (untyped value) -> String?
          def type_cast_for_schema: (untyped value) -> String

          private

          def cast_value: (untyped value) -> untyped
        end
      end
    end
  end
end
