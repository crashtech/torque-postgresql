module Torque
  module PostgreSQL
    class Line < ::Struct[untyped]
      def slope: () -> (Rational | Float)
      def slope=: (Rational | Float value) -> (Rational | Float)
      def intercept: () -> Numeric
      def intercept=: (Numeric value) -> Numeric
      alias c intercept
      alias c= intercept=

      def a=: (Numeric value) -> (Rational | Float)
      def a: () -> Numeric
      def b=: (Numeric value) -> (Rational | Float)
      def b: () -> Numeric
      def horizontal?: () -> bool
      def vertical?: () -> bool
    end

    module Adapter
      module OID
        class Line < Torque::PostgreSQL::GeometryBuilder
          PIECES: ::Array[Symbol]
          FORMATION: String

          def build_klass: (*untyped args) -> untyped
        end
      end
    end
  end
end

class ActiveRecord::Line < Torque::PostgreSQL::Line
end
