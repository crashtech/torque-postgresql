module Torque
  module PostgreSQL
    module Attributes
      module Builder
        class FullTextSearch
          attr_accessor klass: model
          attr_accessor attribute: column_ref
          attr_accessor options: Hash[Symbol, untyped]
          attr_accessor klass_module: Module?
          attr_accessor default_rank: String?
          attr_accessor default_mode: Symbol
          attr_accessor default_order: (:asc | :desc | false)
          attr_accessor default_language: String | Symbol

          @scope_name: String

          def initialize: (model klass, column_ref attribute, ?Hash[Symbol, untyped] options) -> void
          def scope_name: () -> String
          def conflicting?: () -> untyped
          def build: () -> untyped
          def add_scope_to_module: () -> untyped
          def scope_args: () -> String
        end
      end
    end
  end
end
