module Torque
  module PostgreSQL
    module SchemaReflection
      def add_model_name: (SchemaCache::source source, String table_name, model model) -> model?
      def dependencies: (SchemaCache::source source, String table_name) -> Array[String]?
      def associations: (SchemaCache::source source, String table_name) -> Array[String]?
      def lookup_model: (SchemaCache::source source, String table_name, String | model scoped_class) -> model
    end
  end
end

class ActiveRecord::ConnectionAdapters::SchemaReflection
  prepend Torque::PostgreSQL::SchemaReflection
end
